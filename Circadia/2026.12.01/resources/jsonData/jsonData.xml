<resources>
    <!-- Star tables, one packed integer per star (see Stellar in stellar.mc),
         from the Yale Bright Star Catalogue, 5th ed. (Hoffleit & Warren 1991,
         NASA HEASARC). Built by tools/build_stars.py.
         StarsBrightest:      the brightest stars, brightest first.
         StarsConstellations: well-known constellation figures first
                              (figures from d3-celestial, Olaf Frohn).
         StarLines:           the lines of those figures, for the
                              constellations table.
         StarsZodiac:         the zodiac figures and the very brightest
                              first, then the brightest.
         ZodiacLines:         the lines of the zodiac figures, for the
                              zodiac table. -->
    <jsonData id="StarsBrightest"      filename="stars_brightest.json" />
    <jsonData id="StarsConstellations" filename="stars_constellations.json" />
    <jsonData id="StarLines"           filename="stars_lines.json" />
    <jsonData id="StarsZodiac"         filename="stars_zodiac.json" />
    <jsonData id="ZodiacLines"         filename="stars_zodiac_lines.json" />
</resources>
