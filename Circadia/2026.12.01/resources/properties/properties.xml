<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <properties>
        <!-- Data fields -->
        <property id="topField"    type="number">0</property>  
        <property id="leftField"   type="number">2</property>  
        <property id="rightField"  type="number">1</property> 

        <!-- Temperature units: 0 = Celsius, 1 = Fahrenheit, 2 = Kelvin -->
        <property id="tempUnits"   type="number">0</property>

        <!-- Distance units: 0 = kilometres, 1 = miles -->
        <property id="distanceUnits" type="number">0</property>

        <!-- Visual toggles -->
        <property id="showSeconds" type="boolean">false</property>

        <!-- Optional extras, off by default so an update keeps the existing look -->
        <property id="moonDarkSide" type="boolean">false</property>


        <!-- Which stars: 0 = the brightest, 1 = well-known constellations first, 2 = zodiac -->
        <property id="starMode"    type="number">0</property>

        <!-- Location: 1 = use device GPS, 0 = use home coordinates -->
        <property id="useGps"      type="number">1</property>
        <property id="latDeg"      type="float">49.29</property>
        <property id="lonDeg"      type="float">-123.12</property>

        <!-- Always-on display: 0 = default (AMOLED sky only, MIP everything),
             1 = sky only, 2 = clock only -->
        <property id="aodView"      type="number">0</property>
        <!-- The setting before 2026.12.01 (0 = clock only, 1 = sky only), read
             once to carry a Clock only choice over to aodView (config.refresh) -->
        <property id="aodBehaviour" type="number">1</property>

        <!-- Time format: 0 = 24h, 1 = 12h -->
        <property id="timeFormat"  type="number">0</property>

        <!-- Date format: 0 = "Day Number", 1 = "Month Day", 2 = "Day Month" -->
        <property id="dateFormat"  type="number">0</property>

        <!-- Minute colour saturation step: 0-5 (mapped to 0.0, 0.2, ... 1.0) -->
        <property id="minuteSaturation" type="number">4</property>

        <!-- Week start day: 1=Sun, 2=Mon, 3=Tue, 4=Wed, 5=Thu, 6=Fri, 7=Sat -->
        <property id="weekStartDay" type="number">2</property>

        <!-- Sun and moon size: 0 = small (moon 15°), 1 = medium (17.5°, default), 2 = large (20°, the full-size sun) -->
        <property id="moonSize" type="number">1</property>
    </properties>
</resources>
